rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isOwnerRef(userRef) {
      return isSignedIn() && userRef == currentUserRef();
    }

    function hasParticipantIds(data) {
      return data.keys().hasAny(['participantIds']) &&
        data.participantIds is list;
    }

    function isSessionParticipant(data) {
      return isSignedIn() && (
        (hasParticipantIds(data) && request.auth.uid in data.participantIds) ||
        data.studentId == request.auth.uid ||
        data.tutorId == request.auth.uid ||
        data.currentTutorId == request.auth.uid
      );
    }

    function optionalSessionFieldUnchanged(fieldName) {
      return (
        !resource.data.keys().hasAny([fieldName]) &&
        !request.resource.data.keys().hasAny([fieldName])
      ) || (
        resource.data.keys().hasAny([fieldName]) &&
        request.resource.data.keys().hasAny([fieldName]) &&
        request.resource.data[fieldName] == resource.data[fieldName]
      );
    }

    function sessionAccessFieldsUnchanged() {
      return optionalSessionFieldUnchanged('studentId') &&
        optionalSessionFieldUnchanged('tutorId') &&
        optionalSessionFieldUnchanged('currentTutorId') &&
        optionalSessionFieldUnchanged('participantIds');
    }

    function isPromoCodeRedeemUpdate() {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'usageCount',
          'usedBy'
        ]) &&
        request.resource.data.usageCount is int &&
        resource.data.usageCount is int &&
        request.resource.data.usageCount == resource.data.usageCount + 1;
    }

    function isRatingOnlyUpdate() {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'rating'
        ]);
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read: if isSignedIn();
      allow update: if isSelf(userId) || isRatingOnlyUpdate();
      allow delete: if false;
    }

    match /videoSessions/{sessionId} {
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        (
          !request.resource.data.keys().hasAny(['tutorId']) ||
          request.resource.data.tutorId == null
        ) &&
        (
          !request.resource.data.keys().hasAny(['currentTutorId']) ||
          request.resource.data.currentTutorId == null
        ) &&
        (
          !hasParticipantIds(request.resource.data) ||
          (
            request.resource.data.participantIds.size() == 1 &&
            request.auth.uid in request.resource.data.participantIds
          )
        );
      allow read: if isSessionParticipant(resource.data);
      allow update: if isSessionParticipant(resource.data) &&
        sessionAccessFieldsUnchanged();
      allow delete: if false;
    }

    match /users/{userId}/userWords/{wordId} {
      allow create, read, update, delete: if isSelf(userId);
    }

    match /notifications/{notificationId} {
      allow create: if false;
      allow read: if isSignedIn() &&
        resource.data.recipientId == request.auth.uid;
      allow update, delete: if false;
    }

    match /transactions/{transactionId} {
      allow create: if isOwnerRef(request.resource.data.userId);
      allow read: if isOwnerRef(resource.data.userId);
      allow update, delete: if false;
    }

    match /promoCodes/{promoCodeId} {
      allow read: if isSignedIn();
      allow update: if isPromoCodeRedeemUpdate();
      allow create, delete: if false;
    }

    match /reviews/{reviewId} {
      allow create: if isSignedIn() &&
        request.resource.data.fromUserId == currentUserRef() &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    match /withdrawalRequests/{withdrawalRequestId} {
      allow create: if isOwnerRef(request.resource.data.userId);
      allow read: if isOwnerRef(resource.data.userId);
      allow update, delete: if false;
    }

    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /rewiews_of_the_app/{reviewId} {
      allow create: if isSignedIn() &&
        request.resource.data.user == currentUserRef();
      allow read: if isSignedIn() &&
        resource.data.user == currentUserRef();
      allow update, delete: if false;
    }

    match /avatars/{avatarId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /users/{userId}/stats/{statsId} {
      allow read: if isSelf(userId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/cards/{cardId} {
      allow create, read, update, delete: if isSelf(userId);
    }
  }
}
