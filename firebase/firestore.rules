rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasField(data, fieldName) {
      return data.keys().hasAny([fieldName]);
    }

    function fieldEquals(data, fieldName, value) {
      return hasField(data, fieldName) && data[fieldName] == value;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.keys().hasAny(['admin']) &&
        request.auth.token.admin == true;
    }

    function isEventProtectedFromAdminFallback(documentPath) {
      return documentPath[0] in [
        'eventCreationCounters',
        'eventCreateRequests',
        'eventChats'
      ];
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isOwnerRef(userRef) {
      return isSignedIn() && userRef == currentUserRef();
    }

    function isSessionParticipant(data) {
      return isSignedIn() && (
        isParticipantIdForSession(data) ||
        fieldEquals(data, 'studentId', request.auth.uid) ||
        fieldEquals(data, 'tutorId', request.auth.uid) ||
        fieldEquals(data, 'currentTutorId', request.auth.uid)
      );
    }

    function isParticipantIdForSession(data) {
      return isSignedIn() &&
        (
          data.participantIds is list &&
          data.participantIds.hasAny([request.auth.uid])
      );
    }

    function isRequesterForSession(data) {
      return isSignedIn() && fieldEquals(data, 'studentId', request.auth.uid);
    }

    function isResponderForSession(data) {
      return isSignedIn() && (
        fieldEquals(data, 'tutorId', request.auth.uid) ||
        fieldEquals(data, 'currentTutorId', request.auth.uid)
      );
    }

    function isValidSessionNavigationTimestamp(fieldName) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([fieldName]) ||
        request.resource.data[fieldName] == request.time;
    }

    function canUpdateVideoSessionNavigationState() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isSessionParticipant(resource.data) &&
        changedKeys.hasOnly([
          'studentNavigationTriggered',
          'tutorNavigationTriggered',
          'navigationTimestamp',
          'navigationCompletedAt'
        ]) &&
        (
          !changedKeys.hasAny(['studentNavigationTriggered']) ||
          (
            isRequesterForSession(resource.data) &&
            request.resource.data.studentNavigationTriggered is bool
          )
        ) &&
        (
          !changedKeys.hasAny(['tutorNavigationTriggered']) ||
          (
            isResponderForSession(resource.data) &&
            request.resource.data.tutorNavigationTriggered is bool
          ) ||
          (
            isParticipantIdForSession(resource.data) &&
            !isRequesterForSession(resource.data) &&
            request.resource.data.tutorNavigationTriggered is bool
          )
        ) &&
        isValidSessionNavigationTimestamp('navigationTimestamp') &&
        isValidSessionNavigationTimestamp('navigationCompletedAt');
    }

    function videoSessionData(sessionId) {
      return get(/databases/$(database)/documents/videoSessions/$(sessionId)).data;
    }

    function isSafeCaptionRuntimeDiagnosticText(text) {
      return text in [
        'Субтитры временно недоступны: не удалось получить токен распознавания.',
        'Субтитры временно недоступны: сервис распознавания требует настройки.',
        'Субтитры временно недоступны: нет доступа к микрофону.',
        'Субтитры временно недоступны: не удалось передать звук на распознавание.',
        'Субтитры временно недоступны: не удалось запустить распознавание речи.',
        'Субтитры временно недоступны: соединение с распознаванием речи прервано.',
        'Субтитры временно недоступны: не удалось обработать ответ распознавания.',
        'Субтитры временно недоступны: сервис распознавания вернул ошибку.'
      ];
    }

    function isSafeCaptionRuntimeDiagnosticCode(code) {
      return code in [
        'caption_token_unavailable',
        'deepgram_token_grant_forbidden',
        'microphone_permission_denied',
        'audio_stream_error',
        'deepgram_start_failed',
        'deepgram_websocket_error',
        'deepgram_message_parse_failed',
        'deepgram_error_frame'
      ];
    }

    function isSafeCaptionRuntimeDiagnosticPair(code, text) {
      return (
          code == 'caption_token_unavailable' &&
          text == 'Субтитры временно недоступны: не удалось получить токен распознавания.'
        ) ||
        (
          code == 'deepgram_token_grant_forbidden' &&
          text == 'Субтитры временно недоступны: сервис распознавания требует настройки.'
        ) ||
        (
          code == 'microphone_permission_denied' &&
          text == 'Субтитры временно недоступны: нет доступа к микрофону.'
        ) ||
        (
          code == 'audio_stream_error' &&
          text == 'Субтитры временно недоступны: не удалось передать звук на распознавание.'
        ) ||
        (
          code == 'deepgram_start_failed' &&
          text == 'Субтитры временно недоступны: не удалось запустить распознавание речи.'
        ) ||
        (
          code == 'deepgram_websocket_error' &&
          text == 'Субтитры временно недоступны: соединение с распознаванием речи прервано.'
        ) ||
        (
          code == 'deepgram_message_parse_failed' &&
          text == 'Субтитры временно недоступны: не удалось обработать ответ распознавания.'
        ) ||
        (
          code == 'deepgram_error_frame' &&
          text == 'Субтитры временно недоступны: сервис распознавания вернул ошибку.'
        );
    }

    function isReservedCaptionDiagnosticLogId(logId) {
      return logId.matches('system_.*');
    }

    function usesReservedCaptionDiagnosticSpeaker(data) {
      return data.speakerId == 'system' ||
        data.speakerName == 'SmallTalk' ||
        data.speakerRole == 'system';
    }

    function isSafeCaptionParticipantId(value) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= 128 &&
        value.matches('[A-Za-z0-9_.-]+');
    }

    function isOtherSessionParticipantId(sessionData, speakerId) {
      return isSafeCaptionParticipantId(speakerId) &&
        speakerId != request.auth.uid &&
        (
          fieldEquals(sessionData, 'studentId', speakerId) ||
          fieldEquals(sessionData, 'tutorId', speakerId) ||
          fieldEquals(sessionData, 'currentTutorId', speakerId) ||
          (
            sessionData.participantIds is list &&
            sessionData.participantIds.hasAny([speakerId])
          )
        );
    }

    function isCaptionLogIdForSpeaker(data, logId) {
      return logId == data.speakerId + '_' + string(data.utteranceId);
    }

    function canWriteNonDiagnosticCaptionLogData(data, logId) {
      return data.keys().hasOnly([
          'speakerId',
          'speakerName',
          'speakerRole',
          'utteranceId',
          'text',
          'language',
          'source',
          'capturedAtClient',
          'createdAtServer',
          'writerId',
          'confidence'
        ]) &&
        data.source in ['local_deepgram_final', 'peer_legacy_final'] &&
        isSafeCaptionParticipantId(data.speakerId) &&
        data.speakerName is string &&
        data.speakerName.size() > 0 &&
        data.speakerName.size() <= 128 &&
        data.speakerRole in ['student', 'tutor'] &&
        data.utteranceId is int &&
        data.utteranceId >= 0 &&
        data.utteranceId <= 1000000 &&
        data.text is string &&
        data.text.size() > 0 &&
        data.text.size() <= 4000 &&
        data.language is string &&
        data.language.size() <= 32 &&
        data.capturedAtClient is timestamp &&
        data.createdAtServer == request.time &&
        (
          !data.keys().hasAny(['confidence']) ||
          (
            data.confidence is number &&
            data.confidence >= 0 &&
            data.confidence <= 1
          )
        ) &&
        isCaptionLogIdForSpeaker(data, logId) &&
        !isReservedCaptionDiagnosticLogId(logId) &&
        !usesReservedCaptionDiagnosticSpeaker(data);
    }

    function canWriteLocalCaptionLogData(data, logId) {
      return canWriteNonDiagnosticCaptionLogData(data, logId) &&
        data.source == 'local_deepgram_final' &&
        data.speakerId == request.auth.uid;
    }

    function canWritePeerLegacyCaptionLogData(data, logId, sessionData) {
      return canWriteNonDiagnosticCaptionLogData(data, logId) &&
        data.source == 'peer_legacy_final' &&
        isOtherSessionParticipantId(sessionData, data.speakerId);
    }

    function canWriteCaptionRuntimeDiagnostic(data, logId) {
      return data.keys().hasOnly([
          'speakerId',
          'speakerName',
          'speakerRole',
          'utteranceId',
          'text',
          'language',
          'source',
          'capturedAtClient',
          'createdAtServer',
          'writerId',
          'diagnosticCode'
        ]) &&
        data.source == 'caption_runtime_diagnostic' &&
        data.diagnosticCode is string &&
        isSafeCaptionRuntimeDiagnosticCode(data.diagnosticCode) &&
        logId == 'system_' + request.auth.uid + '_' + data.diagnosticCode &&
        data.speakerId == 'system' &&
        data.speakerName == 'SmallTalk' &&
        data.speakerRole == 'system' &&
        data.utteranceId == 0 &&
        data.text is string &&
        isSafeCaptionRuntimeDiagnosticText(data.text) &&
        isSafeCaptionRuntimeDiagnosticPair(data.diagnosticCode, data.text) &&
        data.language is string &&
        data.language.size() <= 32 &&
        data.capturedAtClient is timestamp &&
        data.createdAtServer == request.time;
    }

    function canWriteCaptionLogData(data, logId, sessionData) {
      return data.writerId == request.auth.uid &&
        (
          canWriteLocalCaptionLogData(data, logId) ||
          canWritePeerLegacyCaptionLogData(data, logId, sessionData) ||
          canWriteCaptionRuntimeDiagnostic(data, logId)
        );
    }

    function canUpdateCaptionLogData(data, logId, sessionData) {
      return resource.data.writerId == request.auth.uid &&
        data.writerId == resource.data.writerId &&
        data.speakerId == resource.data.speakerId &&
        data.speakerName == resource.data.speakerName &&
        data.speakerRole == resource.data.speakerRole &&
        data.utteranceId == resource.data.utteranceId &&
        data.source == resource.data.source &&
        canWriteCaptionLogData(data, logId, sessionData);
    }

    function conversationData(pairId) {
      return get(/databases/$(database)/documents/conversations/$(pairId)).data;
    }

    function conversationExists(pairId) {
      return exists(/databases/$(database)/documents/conversations/$(pairId));
    }

    function isConversationParticipantByMap(data) {
      return isSignedIn() &&
        data.participantMap is map &&
        data.participantMap[request.auth.uid] == true;
    }

    function isConversationParticipant(data) {
      return isConversationParticipantByMap(data) || (
        isSignedIn() &&
        data.participantIds is list &&
        request.auth.uid in data.participantIds
      );
    }

    function canUpdateConversationReadMarker() {
      return isSignedIn() &&
        resource.data.isUnlocked == true &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'lastReadAtByUserId'
        ]) &&
        request.resource.data.lastReadAtByUserId is map &&
        resource.data.lastReadAtByUserId is map &&
        request.resource.data.lastReadAtByUserId.keys().hasAll(
          resource.data.lastReadAtByUserId.keys()
        ) &&
        request.resource.data.lastReadAtByUserId.diff(
          resource.data.lastReadAtByUserId
        ).changedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.lastReadAtByUserId[request.auth.uid] == request.time &&
        (
          !resource.data.lastReadAtByUserId.keys().hasAny([request.auth.uid]) ||
          request.resource.data.lastReadAtByUserId[request.auth.uid] >=
          resource.data.lastReadAtByUserId[request.auth.uid]
        );
    }

    function isPromoCodeRedeemUpdate() {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'usageCount',
          'usedBy'
        ]) &&
        request.resource.data.usageCount is int &&
        resource.data.usageCount is int &&
        request.resource.data.usageCount == resource.data.usageCount + 1;
    }

    function hasExplicitTeacherAccreditationStatus(data) {
      return data.keys().hasAny([
        'teacherAccreditationStatus',
        'teacherVerificationStatus',
        'verificationStatus'
      ]);
    }

    function hasExplicitApprovedTeacherAccreditation(data) {
      return (
        data.keys().hasAny(['teacherAccreditationStatus']) &&
        data.teacherAccreditationStatus == 'approved'
      ) ||
      (
        data.keys().hasAny(['teacherVerificationStatus']) &&
        data.teacherVerificationStatus == 'approved'
      ) ||
      (
        data.keys().hasAny(['verificationStatus']) &&
        data.verificationStatus == 'approved'
      );
    }

    function hasMatchProfileApprovedTeacherAccreditation(data) {
      return data.keys().hasAny(['matchProfile']) &&
        data.matchProfile is map &&
        (
          (
            data.matchProfile.keys().hasAny(['teacherAccreditationStatus']) &&
            data.matchProfile.teacherAccreditationStatus == 'approved'
          ) ||
          (
            data.matchProfile.keys().hasAny(['approvedTeacher']) &&
            data.matchProfile.approvedTeacher == true
          )
        );
    }

    function hasApprovedTeacherAccreditation(data) {
      return hasExplicitTeacherAccreditationStatus(data)
        ? hasExplicitApprovedTeacherAccreditation(data)
        : (
          (
            data.keys().hasAny(['verif_NS']) &&
            data.verif_NS == true
          ) ||
          hasMatchProfileApprovedTeacherAccreditation(data)
        );
    }

    function canCreateTransaction() {
      return isAdmin();
    }

    function protectedTeacherAccreditationFields() {
      return [
        'teacherAccreditationStatus',
        'teacherVerificationStatus',
        'verificationStatus',
        'teacherVerificationRequestRef',
        'teacherAccreditationUpdatedAt',
        'verif_NS',
        'matchProfile'
      ];
    }

    function privateUserTokenFields() {
      return [
        'voipToken',
        'voipTokenUpdatedAt',
        'voipPushToken',
        'voipPushTokenUpdatedAt'
      ];
    }

    function teacherVerificationRequestFields() {
      return [
        'userId',
        'userRef',
        'status',
        'displayName',
        'photoUrl',
        'languageInstruction',
        'nativeLanguage',
        'country',
        'accreditation',
        'aboutMe',
        'createdAt',
        'updatedAt',
        'reviewedAt',
        'reviewedBy',
        'reviewComment'
      ];
    }

    function teacherVerificationRequestReviewFields() {
      return [
        'reviewedAt',
        'reviewedBy',
        'reviewComment'
      ];
    }

    function teacherVerificationRequestUserRef(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function teacherVerificationAccreditationFields() {
      return [
        'teachingExperience',
        'qualificationProof',
        'qualificationProofs',
        'qualificationProofFiles'
      ];
    }

    function isValidTeacherVerificationEvidenceFile(userId, file) {
      return file is map &&
        file.keys().hasOnly(['name', 'storagePath']) &&
        file.keys().hasAll(['name', 'storagePath']) &&
        file.name is string &&
        file.storagePath is string &&
        file.storagePath.matches(
          '^users/' + userId + '/teacher_verification/qualification_proofs/[^/]+$'
        );
    }

    function teacherVerificationEvidenceFileAtIsValid(userId, files, index) {
      return files.size() <= index ||
        isValidTeacherVerificationEvidenceFile(userId, files[index]);
    }

    function teacherVerificationEvidenceFilesAreValid(userId, accreditation) {
      return !accreditation.keys().hasAny(['qualificationProofFiles']) ||
        (
          accreditation.qualificationProofFiles is list &&
          accreditation.qualificationProofFiles.size() <= 5 &&
          teacherVerificationEvidenceFileAtIsValid(
            userId,
            accreditation.qualificationProofFiles,
            0
          ) &&
          teacherVerificationEvidenceFileAtIsValid(
            userId,
            accreditation.qualificationProofFiles,
            1
          ) &&
          teacherVerificationEvidenceFileAtIsValid(
            userId,
            accreditation.qualificationProofFiles,
            2
          ) &&
          teacherVerificationEvidenceFileAtIsValid(
            userId,
            accreditation.qualificationProofFiles,
            3
          ) &&
          teacherVerificationEvidenceFileAtIsValid(
            userId,
            accreditation.qualificationProofFiles,
            4
          )
        );
    }

    function teacherVerificationAccreditationIsValid(userId) {
      return !request.resource.data.keys().hasAny(['accreditation']) ||
        (
          request.resource.data.accreditation is map &&
          request.resource.data.accreditation.keys().hasOnly(
            teacherVerificationAccreditationFields()
          ) &&
          (
            !request.resource.data.accreditation.keys().hasAny(['teachingExperience']) ||
            request.resource.data.accreditation.teachingExperience is string
          ) &&
          (
            !request.resource.data.accreditation.keys().hasAny(['qualificationProof']) ||
            request.resource.data.accreditation.qualificationProof is string
          ) &&
          (
            !request.resource.data.accreditation.keys().hasAny(['qualificationProofs']) ||
            request.resource.data.accreditation.qualificationProofs is list
          ) &&
          teacherVerificationEvidenceFilesAreValid(
            userId,
            request.resource.data.accreditation
          )
        );
    }

    function teacherVerificationRequestSnapshotFieldsAreValid(userId) {
      return (
        !request.resource.data.keys().hasAny(['displayName']) ||
        request.resource.data.displayName is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['photoUrl']) ||
        request.resource.data.photoUrl is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['aboutMe']) ||
        request.resource.data.aboutMe is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['languageInstruction']) ||
        request.resource.data.languageInstruction is map
      ) &&
      (
        !request.resource.data.keys().hasAny(['nativeLanguage']) ||
        request.resource.data.nativeLanguage is map
      ) &&
      (
        !request.resource.data.keys().hasAny(['country']) ||
        request.resource.data.country is map
      ) &&
      teacherVerificationAccreditationIsValid(userId);
    }

    function canCreateOwnTeacherVerificationRequest(userId) {
      return isSelf(userId) &&
        request.resource.data.keys().hasOnly(teacherVerificationRequestFields()) &&
        request.resource.data.userId == userId &&
        request.resource.data.userRef == teacherVerificationRequestUserRef(userId) &&
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny(teacherVerificationRequestReviewFields()) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        teacherVerificationRequestSnapshotFieldsAreValid(userId);
    }

    function canUpdateOwnTeacherVerificationRequest(userId) {
      return isSelf(userId) &&
        (
          resource.data.status == 'pending' ||
          resource.data.status == 'rejected'
        ) &&
        request.resource.data.keys().hasOnly(teacherVerificationRequestFields()) &&
        request.resource.data.userId == userId &&
        request.resource.data.userRef == teacherVerificationRequestUserRef(userId) &&
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny(teacherVerificationRequestReviewFields()) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        teacherVerificationRequestSnapshotFieldsAreValid(userId);
    }

    function canCreateOwnUser(userId) {
      return isSelf(userId) &&
        ownUserUidIsValid(userId) &&
        ownUserRoleCreateIsValid() &&
        ownUserLastSeenAtCreateIsValid() &&
        !request.resource.data.keys().hasAny(protectedTeacherAccreditationFields()) &&
        !request.resource.data.keys().hasAny(privateUserTokenFields()) &&
        !request.resource.data.keys().hasAny(privateUserLifecycleFields()) &&
        !request.resource.data.keys().hasAny(serverOwnedUserFields());
    }

    function canUpdateOwnUser(userId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isSelf(userId) &&
        ownUserUidUpdateIsValid(userId) &&
        ownUserRoleUpdateIsValid() &&
        ownUserLastSeenAtUpdateIsValid(changedKeys) &&
        !changedKeys.hasAny(privateUserTokenFields()) &&
        !changedKeys.hasAny(privateUserLifecycleFields()) &&
        !changedKeys.hasAny(serverOwnedUserFields()) &&
        (
          !changedKeys.hasAny(protectedTeacherAccreditationFields()) ||
          canSetOwnTeacherAccreditationPending()
        );
    }

    function ownUserLastSeenAtCreateIsValid() {
      return !request.resource.data.keys().hasAny(['lastSeenAt']) ||
        request.resource.data.lastSeenAt == request.time;
    }

    function ownUserLastSeenAtUpdateIsValid(changedKeys) {
      return !changedKeys.hasAny(['lastSeenAt']) ||
        request.resource.data.lastSeenAt == request.time;
    }

    function canReadUserDocument(userId) {
      return isAdmin() ||
        isSelf(userId) ||
        (
          isSignedIn() &&
          resource.data.uid == request.auth.uid
        );
    }

    function ownUserUidIsValid(userId) {
      return !request.resource.data.keys().hasAny(['uid']) ||
        request.resource.data.uid == userId;
    }

    function ownUserUidUpdateIsValid(userId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']) ||
        request.resource.data.uid == userId;
    }

    function ownUserRoleCreateIsValid() {
      return !request.resource.data.keys().hasAny(['role']) ||
        request.resource.data.get('role', '') in ['student', 'native_speaker'];
    }

    function ownUserRoleUpdateIsValid() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny(['role']) ||
        (
          request.resource.data.get('role', '') == 'student' ||
          canSetInitialOwnRole() ||
          canSetOwnNativeSpeakerRole()
        );
    }

    function canSetInitialOwnRole() {
      return !resource.data.keys().hasAny(['role']) &&
        request.resource.data.get('role', '') in ['student', 'native_speaker'];
    }

    function canSetOwnNativeSpeakerRole() {
      return request.resource.data.get('role', '') == 'native_speaker' &&
        (
          hasApprovedTeacherAccreditation(resource.data) ||
          hasPendingTeacherAccreditation(resource.data) ||
          canSetOwnTeacherAccreditationPending()
        );
    }

    function hasPendingTeacherAccreditation(data) {
      return (
        data.keys().hasAny(['teacherAccreditationStatus']) &&
        data.teacherAccreditationStatus == 'pending'
      ) ||
      (
        data.keys().hasAny(['teacherVerificationStatus']) &&
        data.teacherVerificationStatus == 'pending'
      ) ||
      (
        data.keys().hasAny(['verificationStatus']) &&
        data.verificationStatus == 'pending'
      );
    }

    function privateUserLifecycleFields() {
      return [
        'currentSessionId',
        'isAvailable',
        'isInCall',
        'availableAfter',
        'lastCallEndedAt'
      ];
    }

    function serverOwnedUserFields() {
      return [
        'balanceST',
        'balance_NS',
        'earnings',
        'giftMinutes',
        'priorityScore',
        'rating',
        'subscription',
        'queuePriority',
        'totalCalls'
      ];
    }

    function canSetOwnTeacherAccreditationPending() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'teacherAccreditationStatus',
          'verif_NS'
        ]) &&
        (
          resource.data.get('teacherAccreditationStatus', null) != 'approved'
        ) &&
        (
          resource.data.get('verif_NS', null) != true
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'teacherVerificationStatus',
          'verificationStatus',
          'teacherVerificationRequestRef',
          'teacherAccreditationUpdatedAt',
          'matchProfile'
        ]) &&
        request.resource.data.get('teacherAccreditationStatus', null) == 'pending' &&
        request.resource.data.get('verif_NS', null) == false;
    }

    function canListActiveEvent(data) {
      return isSignedIn() && data.status == 'active';
    }

    function directEventEditFields() {
      return [
        'title',
        'description',
        'levelMin',
        'levelMax',
        'locationName',
        'locationGeoPoint',
        'startsAt',
        'capacity',
        'updatedAt'
      ];
    }

    function directEventEditContentFields() {
      return [
        'title',
        'description',
        'levelMin',
        'levelMax',
        'locationName',
        'locationGeoPoint',
        'startsAt',
        'capacity'
      ];
    }

    function directEventEditRequiredFields() {
      return [
        'title',
        'description',
        'levelMin',
        'levelMax',
        'locationName',
        'locationGeoPoint',
        'startsAt',
        'capacity',
        'participantsCount',
        'updatedAt',
        'status',
        'canceledAt'
      ];
    }

    function isValidEventLevel(value) {
      return value in ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
    }

    function isAllowedEventStatus(value) {
      return value in ['active', 'canceled'];
    }

    function isValidEventLevelRange(data) {
      return (
          data.levelMin == 'A1' &&
          data.levelMax in ['A1', 'A2', 'B1', 'B2', 'C1', 'C2']
        ) ||
        (
          data.levelMin == 'A2' &&
          data.levelMax in ['A2', 'B1', 'B2', 'C1', 'C2']
        ) ||
        (
          data.levelMin == 'B1' &&
          data.levelMax in ['B1', 'B2', 'C1', 'C2']
        ) ||
        (
          data.levelMin == 'B2' &&
          data.levelMax in ['B2', 'C1', 'C2']
        ) ||
        (
          data.levelMin == 'C1' &&
          data.levelMax in ['C1', 'C2']
        ) ||
        (
          data.levelMin == 'C2' &&
          data.levelMax == 'C2'
        );
    }

    function isValidEventGeoPoint(data) {
      return !data.keys().hasAny(['locationGeoPoint']) ||
        data.locationGeoPoint == null ||
        data.locationGeoPoint is latlng;
    }

    function isValidDirectEventEditData(data) {
      return data.keys().hasAll(directEventEditRequiredFields()) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 70 &&
        data.description is string &&
        data.description.size() > 0 &&
        data.description.size() <= 1000 &&
        isValidEventLevel(data.levelMin) &&
        isValidEventLevel(data.levelMax) &&
        isValidEventLevelRange(data) &&
        data.locationName is string &&
        data.locationName.size() > 0 &&
        data.locationName.size() <= 200 &&
        isValidEventGeoPoint(data) &&
        data.startsAt is timestamp &&
        data.startsAt > request.time &&
        data.capacity is int &&
        data.capacity >= 2 &&
        data.capacity <= 50 &&
        data.participantsCount is int &&
        data.participantsCount >= 1 &&
        data.capacity >= data.participantsCount &&
        data.updatedAt == request.time &&
        isAllowedEventStatus(data.status) &&
        data.status == 'active' &&
        data.canceledAt == null;
    }

    function canDirectlyEditOwnEvent() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn() &&
        resource.data.organizerId == request.auth.uid &&
        resource.data.status == 'active' &&
        resource.data.canceledAt == null &&
        resource.data.startsAt is timestamp &&
        resource.data.startsAt > request.time &&
        changedKeys.hasOnly(directEventEditFields()) &&
        changedKeys.hasAny(directEventEditContentFields()) &&
        isValidDirectEventEditData(request.resource.data);
    }

    function eventDocumentData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function eventDocumentExists(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId));
    }

    function eventIsActive(eventId) {
      return eventDocumentExists(eventId) &&
        eventDocumentData(eventId).status == 'active';
    }

    function eventParticipantDocumentExists(eventId, userId) {
      return exists(
        /databases/$(database)/documents/events/$(eventId)/participants/$(userId)
      );
    }

    function eventParticipantDocumentData(eventId, userId) {
      return get(
        /databases/$(database)/documents/events/$(eventId)/participants/$(userId)
      ).data;
    }

    function isValidEventParticipantRole(value) {
      return value in ['organizer', 'participant'];
    }

    function isValidEventParticipantStatus(value) {
      return value in ['active', 'left'];
    }

    function hasValidEventParticipantPhoto(data) {
      return !data.keys().hasAny(['photoUrl']) ||
        data.photoUrl == null ||
        (
          data.photoUrl is string &&
          data.photoUrl.size() <= 2048
        );
    }

    function isValidEventParticipantReadData(userId, data) {
      return data.keys().hasOnly([
          'userId',
          'displayName',
          'photoUrl',
          'role',
          'status',
          'joinedAt',
          'leftAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'userId',
          'displayName',
          'role',
          'status',
          'joinedAt',
          'leftAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId == userId &&
        data.displayName is string &&
        data.displayName.size() > 0 &&
        data.displayName.size() <= 70 &&
        hasValidEventParticipantPhoto(data) &&
        isValidEventParticipantRole(data.role) &&
        isValidEventParticipantStatus(data.status) &&
        data.joinedAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (
          (
            data.status == 'active' &&
            data.leftAt == null
          ) ||
          (
            data.status == 'left' &&
            data.leftAt is timestamp
          )
        );
    }

    function canGetEventParticipant(eventId, userId, data) {
      return isSignedIn() &&
        eventIsActive(eventId) &&
        isValidEventParticipantReadData(userId, data) &&
        data.status == 'active';
    }

    function canGetOwnEventParticipant(eventId, userId, data) {
      return isSelf(userId) &&
        eventIsActive(eventId) &&
        (
          !eventParticipantDocumentExists(eventId, userId) ||
          isValidEventParticipantReadData(userId, data)
        );
    }

    function canListActiveEventParticipants(eventId, data) {
      return isSignedIn() &&
        eventIsActive(eventId) &&
        request.query.limit <= 50 &&
        data.status == 'active';
    }

    function hasValidEventChatMetadata(chatId, data) {
      return data.keys().hasOnly([
          'eventId',
          'readAccessUserIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'eventId',
          'readAccessUserIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.eventId == chatId &&
        data.readAccessUserIds is list &&
        data.readAccessUserIds.size() <= 50 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function eventHasMatchingActiveChat(chatId) {
      return eventDocumentExists(chatId) &&
        eventDocumentData(chatId).chatId == chatId &&
        eventDocumentData(chatId).status == 'active' &&
        eventDocumentData(chatId).canceledAt == null;
    }

    function isActiveEventParticipant(eventId, userId) {
      return eventParticipantDocumentExists(eventId, userId) &&
        isValidEventParticipantReadData(
          userId,
          eventParticipantDocumentData(eventId, userId)
        ) &&
        eventParticipantDocumentData(eventId, userId).status == 'active' &&
        eventParticipantDocumentData(eventId, userId).leftAt == null;
    }

    function canGetActiveEventChat(chatId, data) {
      return isSignedIn() &&
        hasValidEventChatMetadata(chatId, data) &&
        eventHasMatchingActiveChat(chatId) &&
        isActiveEventParticipant(chatId, request.auth.uid);
    }

    match /users/{userId} {
      allow create: if isAdmin() || canCreateOwnUser(userId);
      allow get, list: if canReadUserDocument(userId);
      allow update: if isAdmin() || canUpdateOwnUser(userId);
      allow delete: if isAdmin();
    }

    match /userPrivateTokens/{userId} {
      allow read, write: if false;
    }

    match /registrationGiftClaims/{userId} {
      allow read, write: if isAdmin();
    }

    match /userPublicProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /teacherVerificationRequests/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isAdmin() || canCreateOwnTeacherVerificationRequest(userId);
      allow update: if isAdmin() || canUpdateOwnTeacherVerificationRequest(userId);
      allow delete: if isAdmin();
    }

    match /videoSessions/{sessionId} {
      allow create: if false;
      allow read: if isSessionParticipant(resource.data);
      allow update: if isAdmin() || canUpdateVideoSessionNavigationState();
      allow delete: if false;

      match /captionLogs/{logId} {
        allow read: if isSessionParticipant(videoSessionData(sessionId));
        allow create: if isSessionParticipant(videoSessionData(sessionId)) &&
          canWriteCaptionLogData(
            request.resource.data,
            logId,
            videoSessionData(sessionId)
          );
        allow update: if isSessionParticipant(videoSessionData(sessionId)) &&
          canUpdateCaptionLogData(
            request.resource.data,
            logId,
            videoSessionData(sessionId)
          );
        allow delete: if false;
      }
    }

    match /conversationUnlockEvents/{sessionId} {
      allow create, read, update, delete: if false;
    }

    match /matchPairDailyCompletions/{completionId} {
      allow create, read, update, delete: if false;
    }

    match /conversations/{pairId} {
      allow get: if isConversationParticipant(resource.data);
      allow list: if isConversationParticipantByMap(resource.data);
      allow create: if false;
      allow update: if isConversationParticipant(resource.data) &&
        canUpdateConversationReadMarker();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if conversationExists(pairId) &&
          isConversationParticipant(conversationData(pairId)) &&
          conversationData(pairId).isUnlocked == true;
        allow create: if conversationExists(pairId) &&
          isConversationParticipant(conversationData(pairId)) &&
          conversationData(pairId).isUnlocked == true &&
          request.resource.data.keys().hasOnly([
            'senderId',
            'senderRef',
            'type',
            'text',
            'createdAt'
          ]) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderRef == currentUserRef() &&
          request.resource.data.type == 'text' &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /events/{eventId} {
      allow list: if canListActiveEvent(resource.data);
      allow create: if false;
      allow update: if canDirectlyEditOwnEvent();
      allow delete: if false;

      match /participants/{userId} {
        allow get: if canGetOwnEventParticipant(eventId, userId, resource.data) ||
          canGetEventParticipant(eventId, userId, resource.data);
        allow list: if canListActiveEventParticipants(eventId, resource.data);
        allow create, update, delete: if false;
      }
    }

    match /eventChats/{chatId} {
      allow get: if canGetActiveEventChat(chatId, resource.data);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /users/{userId}/userWords/{wordId} {
      allow create, read, update, delete: if isAdmin() || isSelf(userId);
    }

    match /users/{userId}/wordReviews/{reviewId} {
      allow create, read, update, delete: if isAdmin() || isSelf(userId);
    }

    match /notifications/{notificationId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource.data.recipientId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow create: if canCreateTransaction();
      allow read: if isAdmin() || isOwnerRef(resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /promoCodes/{promoCodeId} {
      allow read: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || isPromoCodeRedeemUpdate();
      allow create, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.fromUserId == currentUserRef() &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5
      );
      allow read: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /rewiews_of_the_app/{reviewId} {
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.user == currentUserRef()
      );
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource.data.user == currentUserRef()
      );
      allow update, delete: if isAdmin();
    }

    match /avatars/{avatarId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/stats/{statsId} {
      allow create, read, update, delete: if isAdmin() || isSelf(userId);
    }

    match /users/{userId}/cards/{cardId} {
      allow create, read, update, delete: if isAdmin() || isSelf(userId);
    }

    match /eventCreationCounters/{document=**} {
      allow read, write: if false;
    }

    match /eventCreateRequests/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read: if isAdmin() && !isEventProtectedFromAdminFallback(document);
    }
  }
}
