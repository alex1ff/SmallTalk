rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasField(data, fieldName) {
      return data.keys().hasAny([fieldName]);
    }

    function fieldEquals(data, fieldName, value) {
      return hasField(data, fieldName) && data[fieldName] == value;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.keys().hasAny(['admin']) &&
        request.auth.token.admin == true;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isOwnerRef(userRef) {
      return isSignedIn() && userRef == currentUserRef();
    }

    function isSessionParticipant(data) {
      return isSignedIn() && (
        isParticipantIdForSession(data) ||
        fieldEquals(data, 'studentId', request.auth.uid) ||
        fieldEquals(data, 'tutorId', request.auth.uid) ||
        fieldEquals(data, 'currentTutorId', request.auth.uid)
      );
    }

    function isParticipantIdForSession(data) {
      return isSignedIn() &&
        (
          data.participantIds is list &&
          data.participantIds.hasAny([request.auth.uid])
      );
    }

    function isRequesterForSession(data) {
      return isSignedIn() && fieldEquals(data, 'studentId', request.auth.uid);
    }

    function isResponderForSession(data) {
      return isSignedIn() && (
        fieldEquals(data, 'tutorId', request.auth.uid) ||
        fieldEquals(data, 'currentTutorId', request.auth.uid)
      );
    }

    function isValidSessionNavigationTimestamp(fieldName) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([fieldName]) ||
        request.resource.data[fieldName] == request.time;
    }

    function canUpdateVideoSessionNavigationState() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isSessionParticipant(resource.data) &&
        changedKeys.hasOnly([
          'studentNavigationTriggered',
          'tutorNavigationTriggered',
          'navigationTimestamp',
          'navigationCompletedAt'
        ]) &&
        (
          !changedKeys.hasAny(['studentNavigationTriggered']) ||
          (
            isRequesterForSession(resource.data) &&
            request.resource.data.studentNavigationTriggered is bool
          )
        ) &&
        (
          !changedKeys.hasAny(['tutorNavigationTriggered']) ||
          (
            isResponderForSession(resource.data) &&
            request.resource.data.tutorNavigationTriggered is bool
          ) ||
          (
            isParticipantIdForSession(resource.data) &&
            !isRequesterForSession(resource.data) &&
            request.resource.data.tutorNavigationTriggered is bool
          )
        ) &&
        isValidSessionNavigationTimestamp('navigationTimestamp') &&
        isValidSessionNavigationTimestamp('navigationCompletedAt');
    }

    function videoSessionData(sessionId) {
      return get(/databases/$(database)/documents/videoSessions/$(sessionId)).data;
    }

    function conversationData(pairId) {
      return get(/databases/$(database)/documents/conversations/$(pairId)).data;
    }

    function conversationExists(pairId) {
      return exists(/databases/$(database)/documents/conversations/$(pairId));
    }

    function isConversationParticipantByMap(data) {
      return isSignedIn() &&
        data.participantMap is map &&
        data.participantMap[request.auth.uid] == true;
    }

    function isConversationParticipant(data) {
      return isConversationParticipantByMap(data) || (
        isSignedIn() &&
        data.participantIds is list &&
        request.auth.uid in data.participantIds
      );
    }

    function canUpdateConversationReadMarker() {
      return isSignedIn() &&
        resource.data.isUnlocked == true &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'lastReadAtByUserId'
        ]) &&
        request.resource.data.lastReadAtByUserId is map &&
        resource.data.lastReadAtByUserId is map &&
        request.resource.data.lastReadAtByUserId.keys().hasAll(
          resource.data.lastReadAtByUserId.keys()
        ) &&
        request.resource.data.lastReadAtByUserId.diff(
          resource.data.lastReadAtByUserId
        ).changedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.lastReadAtByUserId[request.auth.uid] == request.time &&
        (
          !resource.data.lastReadAtByUserId.keys().hasAny([request.auth.uid]) ||
          request.resource.data.lastReadAtByUserId[request.auth.uid] >=
          resource.data.lastReadAtByUserId[request.auth.uid]
        );
    }

    function isPromoCodeRedeemUpdate() {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'usageCount',
          'usedBy'
        ]) &&
        request.resource.data.usageCount is int &&
        resource.data.usageCount is int &&
        request.resource.data.usageCount == resource.data.usageCount + 1;
    }

    function hasExplicitTeacherAccreditationStatus(data) {
      return data.keys().hasAny([
        'teacherAccreditationStatus',
        'teacherVerificationStatus',
        'verificationStatus'
      ]);
    }

    function hasExplicitApprovedTeacherAccreditation(data) {
      return (
        data.keys().hasAny(['teacherAccreditationStatus']) &&
        data.teacherAccreditationStatus == 'approved'
      ) ||
      (
        data.keys().hasAny(['teacherVerificationStatus']) &&
        data.teacherVerificationStatus == 'approved'
      ) ||
      (
        data.keys().hasAny(['verificationStatus']) &&
        data.verificationStatus == 'approved'
      );
    }

    function hasMatchProfileApprovedTeacherAccreditation(data) {
      return data.keys().hasAny(['matchProfile']) &&
        data.matchProfile is map &&
        (
          (
            data.matchProfile.keys().hasAny(['teacherAccreditationStatus']) &&
            data.matchProfile.teacherAccreditationStatus == 'approved'
          ) ||
          (
            data.matchProfile.keys().hasAny(['approvedTeacher']) &&
            data.matchProfile.approvedTeacher == true
          )
        );
    }

    function hasApprovedTeacherAccreditation(data) {
      return hasExplicitTeacherAccreditationStatus(data)
        ? hasExplicitApprovedTeacherAccreditation(data)
        : (
          (
            data.keys().hasAny(['verif_NS']) &&
            data.verif_NS == true
          ) ||
          hasMatchProfileApprovedTeacherAccreditation(data)
        );
    }

    function canCreateTransaction() {
      return isAdmin();
    }

    function protectedTeacherAccreditationFields() {
      return [
        'teacherAccreditationStatus',
        'teacherVerificationStatus',
        'verificationStatus',
        'teacherVerificationRequestRef',
        'teacherAccreditationUpdatedAt',
        'verif_NS',
        'matchProfile'
      ];
    }

    function privateUserTokenFields() {
      return [
        'voipToken',
        'voipTokenUpdatedAt',
        'voipPushToken',
        'voipPushTokenUpdatedAt'
      ];
    }

    function teacherVerificationRequestFields() {
      return [
        'userId',
        'userRef',
        'status',
        'displayName',
        'photoUrl',
        'languageInstruction',
        'nativeLanguage',
        'country',
        'accreditation',
        'aboutMe',
        'createdAt',
        'updatedAt',
        'reviewedAt',
        'reviewedBy',
        'reviewComment'
      ];
    }

    function teacherVerificationRequestReviewFields() {
      return [
        'reviewedAt',
        'reviewedBy',
        'reviewComment'
      ];
    }

    function teacherVerificationRequestUserRef(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function teacherVerificationAccreditationFields() {
      return [
        'teachingExperience',
        'qualificationProof',
        'qualificationProofs',
        'qualificationProofFiles'
      ];
    }

    function isValidTeacherVerificationEvidenceFile(userId, file) {
      return file is map &&
        file.keys().hasOnly(['name', 'storagePath']) &&
        file.keys().hasAll(['name', 'storagePath']) &&
        file.name is string &&
        file.storagePath is string &&
        file.storagePath.matches(
          '^users/' + userId + '/teacher_verification/qualification_proofs/[^/]+$'
        );
    }

    function teacherVerificationEvidenceFileAtIsValid(userId, files, index) {
      return files.size() <= index ||
        isValidTeacherVerificationEvidenceFile(userId, files[index]);
    }

    function teacherVerificationEvidenceFilesAreValid(userId, accreditation) {
      return !accreditation.keys().hasAny(['qualificationProofFiles']) ||
        (
          accreditation.qualificationProofFiles is list &&
          accreditation.qualificationProofFiles.size() <= 5 &&
          teacherVerificationEvidenceFileAtIsValid(
            userId,
            accreditation.qualificationProofFiles,
            0
          ) &&
          teacherVerificationEvidenceFileAtIsValid(
            userId,
            accreditation.qualificationProofFiles,
            1
          ) &&
          teacherVerificationEvidenceFileAtIsValid(
            userId,
            accreditation.qualificationProofFiles,
            2
          ) &&
          teacherVerificationEvidenceFileAtIsValid(
            userId,
            accreditation.qualificationProofFiles,
            3
          ) &&
          teacherVerificationEvidenceFileAtIsValid(
            userId,
            accreditation.qualificationProofFiles,
            4
          )
        );
    }

    function teacherVerificationAccreditationIsValid(userId) {
      return !request.resource.data.keys().hasAny(['accreditation']) ||
        (
          request.resource.data.accreditation is map &&
          request.resource.data.accreditation.keys().hasOnly(
            teacherVerificationAccreditationFields()
          ) &&
          (
            !request.resource.data.accreditation.keys().hasAny(['teachingExperience']) ||
            request.resource.data.accreditation.teachingExperience is string
          ) &&
          (
            !request.resource.data.accreditation.keys().hasAny(['qualificationProof']) ||
            request.resource.data.accreditation.qualificationProof is string
          ) &&
          (
            !request.resource.data.accreditation.keys().hasAny(['qualificationProofs']) ||
            request.resource.data.accreditation.qualificationProofs is list
          ) &&
          teacherVerificationEvidenceFilesAreValid(
            userId,
            request.resource.data.accreditation
          )
        );
    }

    function teacherVerificationRequestSnapshotFieldsAreValid(userId) {
      return (
        !request.resource.data.keys().hasAny(['displayName']) ||
        request.resource.data.displayName is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['photoUrl']) ||
        request.resource.data.photoUrl is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['aboutMe']) ||
        request.resource.data.aboutMe is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['languageInstruction']) ||
        request.resource.data.languageInstruction is map
      ) &&
      (
        !request.resource.data.keys().hasAny(['nativeLanguage']) ||
        request.resource.data.nativeLanguage is map
      ) &&
      (
        !request.resource.data.keys().hasAny(['country']) ||
        request.resource.data.country is map
      ) &&
      teacherVerificationAccreditationIsValid(userId);
    }

    function canCreateOwnTeacherVerificationRequest(userId) {
      return isSelf(userId) &&
        request.resource.data.keys().hasOnly(teacherVerificationRequestFields()) &&
        request.resource.data.userId == userId &&
        request.resource.data.userRef == teacherVerificationRequestUserRef(userId) &&
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny(teacherVerificationRequestReviewFields()) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        teacherVerificationRequestSnapshotFieldsAreValid(userId);
    }

    function canUpdateOwnTeacherVerificationRequest(userId) {
      return isSelf(userId) &&
        (
          resource.data.status == 'pending' ||
          resource.data.status == 'rejected'
        ) &&
        request.resource.data.keys().hasOnly(teacherVerificationRequestFields()) &&
        request.resource.data.userId == userId &&
        request.resource.data.userRef == teacherVerificationRequestUserRef(userId) &&
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny(teacherVerificationRequestReviewFields()) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        teacherVerificationRequestSnapshotFieldsAreValid(userId);
    }

    function canCreateOwnUser(userId) {
      return isSelf(userId) &&
        ownUserUidIsValid(userId) &&
        ownUserRoleCreateIsValid() &&
        ownUserLastSeenAtCreateIsValid() &&
        !request.resource.data.keys().hasAny(protectedTeacherAccreditationFields()) &&
        !request.resource.data.keys().hasAny(privateUserTokenFields()) &&
        !request.resource.data.keys().hasAny(privateUserLifecycleFields()) &&
        !request.resource.data.keys().hasAny(serverOwnedUserFields());
    }

    function canUpdateOwnUser(userId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isSelf(userId) &&
        ownUserUidUpdateIsValid(userId) &&
        ownUserRoleUpdateIsValid() &&
        ownUserLastSeenAtUpdateIsValid(changedKeys) &&
        !changedKeys.hasAny(privateUserTokenFields()) &&
        !changedKeys.hasAny(privateUserLifecycleFields()) &&
        !changedKeys.hasAny(serverOwnedUserFields()) &&
        (
          !changedKeys.hasAny(protectedTeacherAccreditationFields()) ||
          canSetOwnTeacherAccreditationPending()
        );
    }

    function ownUserLastSeenAtCreateIsValid() {
      return !request.resource.data.keys().hasAny(['lastSeenAt']) ||
        request.resource.data.lastSeenAt == request.time;
    }

    function ownUserLastSeenAtUpdateIsValid(changedKeys) {
      return !changedKeys.hasAny(['lastSeenAt']) ||
        request.resource.data.lastSeenAt == request.time;
    }

    function canReadUserDocument(userId) {
      return isAdmin() ||
        isSelf(userId) ||
        (
          isSignedIn() &&
          resource.data.uid == request.auth.uid
        );
    }

    function ownUserUidIsValid(userId) {
      return !request.resource.data.keys().hasAny(['uid']) ||
        request.resource.data.uid == userId;
    }

    function ownUserUidUpdateIsValid(userId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']) ||
        request.resource.data.uid == userId;
    }

    function ownUserRoleCreateIsValid() {
      return !request.resource.data.keys().hasAny(['role']) ||
        request.resource.data.get('role', '') in ['student', 'native_speaker'];
    }

    function ownUserRoleUpdateIsValid() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny(['role']) ||
        (
          request.resource.data.get('role', '') == 'student' ||
          canSetInitialOwnRole() ||
          canSetOwnNativeSpeakerRole()
        );
    }

    function canSetInitialOwnRole() {
      return !resource.data.keys().hasAny(['role']) &&
        request.resource.data.get('role', '') in ['student', 'native_speaker'];
    }

    function canSetOwnNativeSpeakerRole() {
      return request.resource.data.get('role', '') == 'native_speaker' &&
        (
          hasApprovedTeacherAccreditation(resource.data) ||
          hasPendingTeacherAccreditation(resource.data) ||
          canSetOwnTeacherAccreditationPending()
        );
    }

    function hasPendingTeacherAccreditation(data) {
      return (
        data.keys().hasAny(['teacherAccreditationStatus']) &&
        data.teacherAccreditationStatus == 'pending'
      ) ||
      (
        data.keys().hasAny(['teacherVerificationStatus']) &&
        data.teacherVerificationStatus == 'pending'
      ) ||
      (
        data.keys().hasAny(['verificationStatus']) &&
        data.verificationStatus == 'pending'
      );
    }

    function privateUserLifecycleFields() {
      return [
        'currentSessionId',
        'isAvailable',
        'isInCall',
        'availableAfter',
        'lastCallEndedAt'
      ];
    }

    function serverOwnedUserFields() {
      return [
        'balanceST',
        'balance_NS',
        'earnings',
        'giftMinutes',
        'priorityScore',
        'rating',
        'subscription',
        'queuePriority',
        'totalCalls'
      ];
    }

    function canSetOwnTeacherAccreditationPending() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'teacherAccreditationStatus',
          'verif_NS'
        ]) &&
        (
          resource.data.get('teacherAccreditationStatus', null) != 'approved'
        ) &&
        (
          resource.data.get('verif_NS', null) != true
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'teacherVerificationStatus',
          'verificationStatus',
          'teacherVerificationRequestRef',
          'teacherAccreditationUpdatedAt',
          'matchProfile'
        ]) &&
        request.resource.data.get('teacherAccreditationStatus', null) == 'pending' &&
        request.resource.data.get('verif_NS', null) == false;
    }

    match /users/{userId} {
      allow create: if isAdmin() || canCreateOwnUser(userId);
      allow get, list: if canReadUserDocument(userId);
      allow update: if isAdmin() || canUpdateOwnUser(userId);
      allow delete: if isAdmin();
    }

    match /userPrivateTokens/{userId} {
      allow read, write: if false;
    }

    match /registrationGiftClaims/{userId} {
      allow read, write: if isAdmin();
    }

    match /userPublicProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /teacherVerificationRequests/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isAdmin() || canCreateOwnTeacherVerificationRequest(userId);
      allow update: if isAdmin() || canUpdateOwnTeacherVerificationRequest(userId);
      allow delete: if isAdmin();
    }

    match /videoSessions/{sessionId} {
      allow create: if false;
      allow read: if isSessionParticipant(resource.data);
      allow update: if isAdmin() || canUpdateVideoSessionNavigationState();
      allow delete: if false;

      match /captionLogs/{logId} {
        allow read: if isSessionParticipant(videoSessionData(sessionId));
        allow create, update: if isSessionParticipant(videoSessionData(sessionId)) &&
          request.resource.data.writerId == request.auth.uid &&
          (
            request.resource.data.speakerId == request.auth.uid ||
            request.resource.data.source == 'peer_legacy_final'
          );
        allow delete: if false;
      }
    }

    match /conversationUnlockEvents/{sessionId} {
      allow create, read, update, delete: if false;
    }

    match /matchPairDailyCompletions/{completionId} {
      allow create, read, update, delete: if false;
    }

    match /conversations/{pairId} {
      allow get: if isConversationParticipant(resource.data);
      allow list: if isConversationParticipantByMap(resource.data);
      allow create: if false;
      allow update: if isConversationParticipant(resource.data) &&
        canUpdateConversationReadMarker();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if conversationExists(pairId) &&
          isConversationParticipant(conversationData(pairId)) &&
          conversationData(pairId).isUnlocked == true;
        allow create: if conversationExists(pairId) &&
          isConversationParticipant(conversationData(pairId)) &&
          conversationData(pairId).isUnlocked == true &&
          request.resource.data.keys().hasOnly([
            'senderId',
            'senderRef',
            'type',
            'text',
            'createdAt'
          ]) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderRef == currentUserRef() &&
          request.resource.data.type == 'text' &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/userWords/{wordId} {
      allow create, read, update, delete: if isAdmin() || isSelf(userId);
    }

    match /users/{userId}/wordReviews/{reviewId} {
      allow create, read, update, delete: if isAdmin() || isSelf(userId);
    }

    match /notifications/{notificationId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource.data.recipientId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow create: if canCreateTransaction();
      allow read: if isAdmin() || isOwnerRef(resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /promoCodes/{promoCodeId} {
      allow read: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || isPromoCodeRedeemUpdate();
      allow create, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.fromUserId == currentUserRef() &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5
      );
      allow read: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /rewiews_of_the_app/{reviewId} {
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.user == currentUserRef()
      );
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource.data.user == currentUserRef()
      );
      allow update, delete: if isAdmin();
    }

    match /avatars/{avatarId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/stats/{statsId} {
      allow create, read, update, delete: if isAdmin() || isSelf(userId);
    }

    match /users/{userId}/cards/{cardId} {
      allow create, read, update, delete: if isAdmin() || isSelf(userId);
    }

    match /{document=**} {
      allow read: if isAdmin();
    }
  }
}
