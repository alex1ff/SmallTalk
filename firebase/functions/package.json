{
  "name": "cloud-functions",
  "description": "Firebase Cloud Functions",
  "dependencies": {
    "axios": "^1.19.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "eslint": "^6.8.0",
    "eslint-plugin-promise": "^4.2.1"
  },
  "scripts": {
    "lint": "./node_modules/.bin/eslint --max-warnings=0 .",
    "serve": "firebase -P smalltalk-2109b emulators:start --only functions",
    "shell": "firebase -P smalltalk-2109b functions:shell",
    "start": "npm run shell",
    "logs": "firebase -P smalltalk-2109b functions:log",
    "compile": "cp ../../tsconfig.template.json ./tsconfig-compile.json && tsc --project tsconfig-compile.json"
  },
  "engines": {
    "node": "22"
  },
  "private": true
}
