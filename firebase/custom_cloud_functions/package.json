{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "backfill:video-session-review-flags": "node scripts/backfill_video_session_review_flags.js",
    "validate:deployment-readiness": "node scripts/validate_deployment_readiness.js",
    "validate:secret-readiness": "node scripts/validate_secret_readiness.js --config ../firebase.json",
    "set:admin-claim": "node scripts/set_admin_claim.js",
    "migrate:pair-reviews": "node scripts/migrate_pair_reviews.js",
    "generate:event-city-catalog": "node scripts/generate_event_city_catalog.js",
    "test:events": "node --test create_event.test.js edit_event.test.js cancel_event.test.js join_event.test.js leave_event.test.js send_event_chat_message.test.js get_event_chat_access_state.test.js event_city_catalog.test.js event_city_catalog_generation.test.js deployment_readiness.test.js",
    "test:event-rules": "node --test event_rules.test.js",
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run deploy:readiness-functions",
    "deploy:readiness-functions": "firebase deploy --project smalltalk-2109b --config ../firebase.json --only functions:custom_cloud_functions:createVideoSession,functions:custom_cloud_functions:acceptCall,functions:custom_cloud_functions:declineCall,functions:custom_cloud_functions:cancelCall,functions:custom_cloud_functions:endSession,functions:custom_cloud_functions:cleanupExpiredSessions,functions:custom_cloud_functions:processExpiredNotifications,functions:custom_cloud_functions:getSessionTokens,functions:custom_cloud_functions:getDeepgramToken,functions:custom_cloud_functions:requestSessionExtension,functions:custom_cloud_functions:persistCallChat,functions:custom_cloud_functions:dailyWebhook,functions:custom_cloud_functions:cleanupFailedDailyRoomDeletes,functions:custom_cloud_functions:getDirectCallStatus,functions:custom_cloud_functions:markSessionConnected,functions:custom_cloud_functions:registerVoipToken,functions:custom_cloud_functions:migrateLegacyVoipTokens,functions:custom_cloud_functions:scheduledLegacyVoipTokenMigration,functions:custom_cloud_functions:claimRegistrationGift,functions:custom_cloud_functions:createEvent,functions:custom_cloud_functions:editEvent,functions:custom_cloud_functions:cancelEvent,functions:custom_cloud_functions:joinEvent,functions:custom_cloud_functions:leaveEvent,functions:custom_cloud_functions:sendEventChatMessage,functions:custom_cloud_functions:getEventChatAccessState,functions:custom_cloud_functions:requestWithdrawal,functions:custom_cloud_functions:syncUserPublicProfile,functions:custom_cloud_functions:revenueCatWebhook,functions:custom_cloud_functions:grantPromoEntitlement,functions:custom_cloud_functions:redeemPromoCode,functions:custom_cloud_functions:sendCustomEmailVerification,functions:custom_cloud_functions:submitReview",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase": "^12.12.0",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
