# Uncomment this line to define a global platform for your project
platform :ios, '14.0.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'
require 'fileutils'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# flutter_callkit_incoming 3.1.3 still keeps one global PushKit payload on iOS.
# A later push can therefore make end/decline/connected target a different
# CallKit UUID. Patch the CocoaPods build copy without mutating the pub cache.
def patch_callkit_incoming_exact_identity(installer)
  target = installer.pods_project.targets.find do |candidate|
    candidate.name == 'flutter_callkit_incoming'
  end
  raise 'flutter_callkit_incoming pod target not found' if target.nil?

  source_ref = target.source_build_phase.files_references.find do |reference|
    File.basename(reference.path.to_s) == 'SwiftFlutterCallkitIncomingPlugin.swift'
  end
  raise 'flutter_callkit_incoming Swift source not found' if source_ref.nil?

  upstream_path = File.expand_path(
    File.join(
      __dir__,
      '.symlinks',
      'plugins',
      'flutter_callkit_incoming',
      'ios',
      'flutter_callkit_incoming',
      'Classes',
      'SwiftFlutterCallkitIncomingPlugin.swift',
    ),
  )
  raise 'flutter_callkit_incoming upstream Swift source not found' unless File.exist?(upstream_path)

  # Always patch the immutable plugin source. On a repeated `pod install`, the
  # existing Pods project may already point at our generated build copy.
  source = File.binread(upstream_path).force_encoding(Encoding::UTF_8)
  raise 'flutter_callkit_incoming Swift source is not valid UTF-8' unless source.valid_encoding?
  # Some cached copies can contain zero padding after the final source brace.
  # Strip only that padding and fail if a NUL appears inside real Swift code.
  source = source.sub(/\x00+\z/, '')
  raise 'flutter_callkit_incoming Swift source contains an embedded NUL' if source.include?("\0")
  source = source.gsub("\r\n", "\n")
  replacements = {
    <<-'OLD' => <<-'NEW',
        // PushKit branch reads uuid from self.data (stored during showCallkitIncoming);
        // non-PushKit reads from the incoming data. Either source can be invalid.
        let uuidSourceString: String
        if self.isFromPushKit {
            guard let stored = self.data else {
                NSLog("[CallkitIncoming] endCall: PushKit branch but self.data is nil — ignored")
                return
            }
            uuidSourceString = stored.uuid
            self.isFromPushKit = false
            self.sendEvent(SwiftFlutterCallkitIncomingPlugin.ACTION_CALL_ENDED, data.toJSON())
        } else {
            uuidSourceString = data.uuid
        }
    OLD
        // SmallTalk: programmatic end must always use the requested UUID.
        let uuidSourceString = data.uuid
        self.isFromPushKit = false
    NEW
    <<-'OLD' => <<-'NEW',
        let uuidSourceString: String
        if self.isFromPushKit {
            guard let stored = self.data else {
                NSLog("[CallkitIncoming] connectedCall: PushKit branch but self.data is nil — ignored")
                return
            }
            uuidSourceString = stored.uuid
            self.isFromPushKit = false
        } else {
            uuidSourceString = data.uuid
        }
    OLD
        // SmallTalk: connected state is scoped to the requested UUID.
        let uuidSourceString = data.uuid
        self.isFromPushKit = false
    NEW
    <<-'OLD' => <<-'NEW',
        guard let call = self.callManager.callWithUUID(uuid: action.callUUID) else {
            if(self.answerCall == nil && self.outgoingCall == nil){
                sendEvent(SwiftFlutterCallkitIncomingPlugin.ACTION_CALL_TIMEOUT, self.data?.toJSON())
            } else {
                sendEvent(SwiftFlutterCallkitIncomingPlugin.ACTION_CALL_ENDED, self.data?.toJSON())
            }
            action.fail()
            return
        }
    OLD
        guard let call = self.callManager.callWithUUID(uuid: action.callUUID) else {
            // SmallTalk: never emit a different call's global PushKit payload.
            action.fail()
            return
        }
    NEW
    'sendEvent(SwiftFlutterCallkitIncomingPlugin.ACTION_CALL_DECLINE, self.data?.toJSON())' =>
      'sendEvent(SwiftFlutterCallkitIncomingPlugin.ACTION_CALL_DECLINE, call.data.toJSON())',
  }

  replacements.each do |before, after|
    count = source.scan(before).length
    raise "Unexpected flutter_callkit_incoming source (match count #{count})" unless count == 1
    source = source.sub(before, after)
  end

  patched_dir = File.join(
    installer.sandbox.root.to_s,
    'SmallTalkPatchedSources',
    'flutter_callkit_incoming',
  )
  FileUtils.mkdir_p(patched_dir)
  patched_path = File.join(patched_dir, 'SwiftFlutterCallkitIncomingPlugin.swift')
  File.open(patched_path, 'wb') { |file| file.write(source) }
  source_ref.path = patched_path
  source_ref.source_tree = '<absolute>'
end

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  pod 'FirebaseFirestore', :git => 'https://github.com/invertase/firestore-ios-sdk-frameworks.git', :tag => '11.13.0'
end

post_install do |installer|
  patch_callkit_incoming_exact_identity(installer)
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',

        # dart: PermissionGroup.camera
        'PERMISSION_CAMERA=1',

        # dart: PermissionGroup.photos
        'PERMISSION_PHOTOS=1',

        # dart: PermissionGroup.microphone
        'PERMISSION_MICROPHONE=1',
      ]
    end
  end
end
